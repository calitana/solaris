<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_login">

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.solartech.mantenimiento.ui.autenticacion.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_registro"
            app:destination="@id/navigation_registro" />
        <action
            android:id="@+id/action_login_to_clientes"
            app:destination="@id/navigation_clientes"
            app:popUpTo="@id/navigation_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_registro"
        android:name="com.solartech.mantenimiento.ui.autenticacion.RegistroFragment"
        android:label="Registro">
        <action
            android:id="@+id/action_registro_to_clientes"
            app:destination="@id/navigation_clientes"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_clientes"
        android:name="com.solartech.mantenimiento.ui.clientes.ClientesFragment"
        android:label="Clientes">
        <action
            android:id="@+id/action_clientes_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_sitios"
        android:name="com.solartech.mantenimiento.ui.sitios.SitiosFragment"
        android:label="Sitios Solares">
        <action
            android:id="@+id/action_sitios_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_mantenimientos"
        android:name="com.solartech.mantenimiento.ui.mantenimiento.MantenimientosFragment"
        android:label="Mantenimientos">
        <action
            android:id="@+id/action_mantenimientos_to_agregar"
            app:destination="@id/navigation_agregar_mantenimiento" />
        <action
            android:id="@+id/action_mantenimientos_to_login"
            app:destination="@id/navigation_login"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_agregar_mantenimiento"
        android:name="com.solartech.mantenimiento.ui.mantenimiento.AgregarMantenimientoFragment"
        android:label="Nueva Orden" />

</navigation>
